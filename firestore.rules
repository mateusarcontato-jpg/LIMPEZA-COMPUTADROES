rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety helper functions
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }
    
    function isValidOptString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Machines collection
    match /machines/{machineId} {
      allow read: if true;
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 120;
      allow update: if request.resource.data.name is string 
                    && request.resource.data.name.size() > 0 
                    && request.resource.data.name.size() <= 120;
      allow delete: if true;
    }

    // Cleaning audit logs
    match /cleaning_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.machineId is string 
                    && request.resource.data.cleanedBy is string;
      allow update: if true;
      allow delete: if true;
    }

    // Staff responsible
    match /staff/{staffId} {
      allow read: if true;
      allow create: if request.resource.data.name is string;
      allow update: if true;
      allow delete: if true;
    }

    // Notifications log
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if request.resource.data.type is string;
      allow update: if true;
      allow delete: if true;
    }
  }
}
